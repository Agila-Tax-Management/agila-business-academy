// prisma/models/users.prisma

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  emailVerified  Boolean        @default(false)
  image          String?
  position       String?
  role           Role           @default(EMPLOYEE)
  approvalStatus ApprovalStatus @default(PENDING)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  sessions      Session[]
  accounts      Account[]

  enrollments        Enrollment[]
  videoProgress      VideoProgress[]
  moduleCompletions  ModuleCompletion[]
  seriesCompletions  SeriesCompletion[]
  examAttempts       ExamAttempt[]
  certificates       Certificate[]
  activityLogs       ActivityLog[]
  notifications      InternalNotification[] @relation("NotificationRecipient")

  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("verifications")
}
