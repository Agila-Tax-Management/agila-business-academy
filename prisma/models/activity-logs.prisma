// prisma/models/activity-logs.prisma

enum LogAction {
  CREATED
  UPDATED
  DELETED
  VIEWED
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  ARCHIVED
  RESTORED
  LOGIN
  LOGOUT
  ASSIGNED
  UNASSIGNED
  STATUS_CHANGE
}

model ActivityLog {
  id          String    @id @default(cuid())
  userId      String
  action      LogAction
  entity      String
  entityId    String?
  description String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
